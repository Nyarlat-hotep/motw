{
  // Cloudflare Workers: the static site from dist/ (written by `npm run build`), plus the shared table under /api/ (worker/, see CLAUDE.md).
  // Pushing `main` deploys this. Only /api/* wakes the Worker; everything else is served straight from the assets, so a fault in the Worker cannot take the journal down.
  "name": "hunters-journal",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "TABLE", "class_name": "Table" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }],
  // Not secrets: the Cloudflare Access team name (the part before .cloudflareaccess.com) and this site's application audience tag.
  // Both are in the address Access sends a signed-out visitor to. The Worker checks every sign-in token against them.
  // The Keeper is whoever is listed in KEEPER_EMAILS (comma separated). It is left out here so the address is not in the repo:
  // add it in the Cloudflare dashboard as a secret on this Worker (Settings, Variables and Secrets), which survives each deploy.
  "vars": { "ACCESS_TEAM": "tiny-recipe-17fa", "ACCESS_AUD": "bb5653f9ffcf470754d6a9407d83d056130be79a5eaaf9638829329a1d2cd8e9" }
}
